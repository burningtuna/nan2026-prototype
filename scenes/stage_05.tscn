[sub_resource type="Shader" id="Shader_stage5_ocean_fade"]
code = "shader_type canvas_item;

uniform float fade_end : hint_range(0.01, 0.5) = 0.14;

void fragment() {
	vec4 color = texture(TEXTURE, UV);
	color.a *= smoothstep(0.0, fade_end, UV.y);
	COLOR = color;
}
"

